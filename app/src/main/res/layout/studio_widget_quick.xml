<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/studio_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/studio_shape_surface"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:id="@+id/studio_quick_resume"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:contentDescription="@string/shortcut_resume">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/studio_quick_resume_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/studio_shape_pill"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="20dp">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <ImageView
                            android:id="@+id/studio_quick_resume_disc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/studio_shape_circle"
                            android:importantForAccessibility="no" />
                        <ImageView
                            android:id="@+id/studio_quick_resume_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_studio_play"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/studio_quick_resume_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:text="@string/shortcut_resume" />
                        <TextView
                            android:id="@+id/studio_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/studio_quick_flow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:contentDescription="@string/widget_flow">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">
                    <ImageView
                        android:id="@+id/studio_quick_flow_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/studio_shape_cookie"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/studio_quick_flow_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_studio_flow"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                    <TextView
                        android:id="@+id/studio_quick_flow_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/widget_flow" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/studio_quick_favorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:contentDescription="@string/widget_favorites">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">
                    <ImageView
                        android:id="@+id/studio_quick_favorites_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/studio_shape_clover"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/studio_quick_favorites_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_studio_favorite"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                    <TextView
                        android:id="@+id/studio_quick_favorites_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/widget_favorites" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/studio_quick_downloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:contentDescription="@string/car_downloads">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">
                    <ImageView
                        android:id="@+id/studio_quick_downloads_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/studio_shape_squircle"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/studio_quick_downloads_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_studio_download"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                    <TextView
                        android:id="@+id/studio_quick_downloads_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/car_downloads" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/studio_quick_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:contentDescription="@string/shortcut_search">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">
                    <ImageView
                        android:id="@+id/studio_quick_search_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/studio_shape_circle"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/studio_quick_search_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_studio_search"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                    <TextView
                        android:id="@+id/studio_quick_search_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/shortcut_search" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/studio_quick_recognize"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:contentDescription="@string/shortcut_recognition">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">
                    <ImageView
                        android:id="@+id/studio_quick_recognize_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/studio_shape_sunny"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/studio_quick_recognize_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_studio_recognize"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                    <TextView
                        android:id="@+id/studio_quick_recognize_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/shortcut_recognition" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/studio_quick_lyrics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:contentDescription="@string/widget_lyrics">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">
                    <ImageView
                        android:id="@+id/studio_quick_lyrics_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/studio_shape_flower"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/studio_quick_lyrics_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_studio_lyrics"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                    <TextView
                        android:id="@+id/studio_quick_lyrics_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/widget_lyrics" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
