<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/studio_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/studio_play"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp">
        <ImageView
            android:id="@+id/studio_play_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/studio_shape_circle"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/studio_play_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_studio_play"
            android:contentDescription="@string/widget_toggle" />
    </FrameLayout>
</FrameLayout>
