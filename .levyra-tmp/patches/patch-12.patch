diff --git a/third_party/LevyraExtractor/extractor/src/main/java/org/schabi/newpipe/extractor/stream/SongMetadata.java b/third_party/LevyraExtractor/extractor/src/main/java/org/schabi/newpipe/extractor/stream/SongMetadata.java
