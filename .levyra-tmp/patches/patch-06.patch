+    @Nullable
+    public static SongMetadata getSongMetadata(@Nonnull final Description description) {
+        final String descriptionText = description.getType() == Description.PLAIN_TEXT
+                ? description.getContent()
+                : Jsoup.parse(description.getContent()).wholeText();
+        return parseSongMetadataText(descriptionText);
+    }
+
+    @Nullable
+    static SongMetadata parseSongMetadataText(@Nullable final String rawText) {
+        if (isNullOrEmpty(rawText)) {
+            return null;
+        }
+
+        final List<String> paragraphs = splitSongMetadataParagraphs(rawText);
+        if (paragraphs.size() < 4 || !isSongMetadataProviderLine(paragraphs.get(0))) {
+            return null;
+        }
+
+        int titleArtistIndex = -1;
+        int releaseDateIndex = -1;
+        String releaseDateValue = null;
+        for (int i = 1; i < paragraphs.size(); i++) {
+            final String paragraph = paragraphs.get(i);
+            if (titleArtistIndex < 0 && paragraph.contains(SONG_METADATA_SEPARATOR)) {
+                titleArtistIndex = i;
+            }
+            final java.util.regex.Matcher dateMatcher = SONG_METADATA_DATE_PATTERN.matcher(paragraph);
+            if (releaseDateIndex < 0 && dateMatcher.find()) {
+                releaseDateIndex = i;
+                releaseDateValue = dateMatcher.group(1);
+            }
+        }
+
+        if (titleArtistIndex < 1 || releaseDateIndex <= titleArtistIndex + 1) {
+            return null;
+        }
+
+        final String titleArtist = paragraphs.get(titleArtistIndex);
+        final int separatorIndex = titleArtist.lastIndexOf(SONG_METADATA_SEPARATOR);
+        if (separatorIndex <= 0
+                || separatorIndex + SONG_METADATA_SEPARATOR.length() >= titleArtist.length()) {
+            return null;
+        }
+
+        final String title = titleArtist.substring(0, separatorIndex).trim();
+        final String artist = titleArtist.substring(
+                separatorIndex + SONG_METADATA_SEPARATOR.length()).trim();
+        final String album = paragraphs.get(titleArtistIndex + 1).trim();
+        if (title.isEmpty() || artist.isEmpty() || album.isEmpty()) {
+            return null;
+        }
+
+        final SongMetadata.Builder builder = new SongMetadata.Builder(title, artist)
+                .setAlbum(album)
+                .setLabel(extractSongMetadataLabel(paragraphs.get(0)));
+
+        for (int i = titleArtistIndex + 2; i < releaseDateIndex; i++) {
+            final String candidate = paragraphs.get(i).trim();
+            if (candidate.startsWith("℗") || candidate.startsWith("©")) {
+                builder.setCopyright(cleanSongMetadataCopyright(candidate));
+                break;
+            }
+        }
+
+        if (releaseDateValue != null) {
+            try {
+                builder.setReleaseDate(new DateWrapper(
+                        LocalDate.parse(releaseDateValue)
+                                .atStartOfDay()
+                                .atOffset(ZoneOffset.UTC), false));
+            } catch (final DateTimeParseException ignored) {
+            }
+        }
+
+        final LinkedHashSet<String> composers = new LinkedHashSet<>();
+        for (int i = releaseDateIndex + 1; i < paragraphs.size(); i++) {
+            final String paragraph = paragraphs.get(i);
+            for (final String line : paragraph.split("\\n")) {
+                final int colon = line.indexOf(':');
+                if (colon <= 0 || colon >= line.length() - 1) {
+                    continue;
+                }
+                final String role = normalizeSongMetadataRole(line.substring(0, colon));
+                final String value = line.substring(colon + 1).trim();
+                if (value.isEmpty()) {
+                    continue;
+                }
+                if (matchesSongMetadataRole(role, SONG_METADATA_COMPOSER_ROLES)) {
+                    composers.add(value);
+                }
+                if (matchesSongMetadataRole(role, SONG_METADATA_PERFORMER_ROLES)) {
+                    builder.addPerformer(value);
+                }
+            }
+        }
+        if (!composers.isEmpty()) {
+            builder.setComposer(String.join(", ", composers));
+        }
+        return builder.build();
+    }
+
+    @Nonnull
+    private static List<String> splitSongMetadataParagraphs(@Nonnull final String rawText) {
+        final String normalized = rawText.replace("\r\n", "\n")
+                .replace('\r', '\n')
+                .replace("\u00a0", " ")
+                .trim();
+        if (normalized.isEmpty()) {
+            return Collections.emptyList();
+        }
+        final List<String> paragraphs = Arrays.stream(normalized.split("\\n\\s*\\n+"))
+                .map(String::trim)
+                .filter(value -> !value.isEmpty())
+                .collect(Collectors.toList());
+        if (paragraphs.size() >= 4) {
+            return paragraphs;
+        }
+        return Arrays.stream(normalized.split("\\n+"))
+                .map(String::trim)
+                .filter(value -> !value.isEmpty())
+                .collect(Collectors.toList());
+    }
+
+    private static boolean isSongMetadataProviderLine(@Nonnull final String providerLine) {
+        return SONG_METADATA_PROVIDER_PREFIXES.stream().anyMatch(providerLine::startsWith);
+    }
+
+    @Nullable
+    private static String extractSongMetadataLabel(@Nonnull final String providerLine) {
+        for (final String prefix : SONG_METADATA_PROVIDER_PREFIXES) {
+            if (providerLine.startsWith(prefix)) {
+                final String label = providerLine.substring(prefix.length()).trim();
+                return label.isEmpty() ? null : label;
+            }
+        }
+        return null;
+    }
+
+    @Nonnull
+    private static String normalizeSongMetadataRole(@Nonnull final String value) {
+        return Normalizer.normalize(value, Normalizer.Form.NFD)
+                .replaceAll("\\p{M}+", "")
+                .toLowerCase(Locale.ROOT)
+                .trim();
+    }
+
+    private static boolean matchesSongMetadataRole(@Nonnull final String role,
+                                                   @Nonnull final List<String> keywords) {
+        return keywords.stream().anyMatch(role::contains);
+    }
+
+    @Nullable
+    private static String cleanSongMetadataCopyright(@Nullable final String value) {
+        if (value == null) {
+            return null;
+        }
+        String cleaned = value.trim();
+        while (cleaned.startsWith("℗") || cleaned.startsWith("©")) {
+            cleaned = cleaned.substring(1).trim();
+        }
+        return cleaned.isEmpty() ? null : cleaned;
+    }
