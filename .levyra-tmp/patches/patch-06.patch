+    @Nullable
+    public static String extractXtagsValue(@Nullable final String xtags,
+                                           @Nonnull final String wantedKey) {
+        if (isNullOrEmpty(xtags)) {
+            return null;
+        }
+        try {
+            final String padded = xtags + "====".substring(0, (4 - xtags.length() % 4) % 4);
+            final byte[] data = Base64.getUrlDecoder().decode(padded);
+            int position = 0;
+            while (position < data.length) {
+                final int[] cursor = {position};
+                final long tag = readProtoVarint(data, cursor);
+                position = cursor[0];
+                if ((tag & 7) != 2) {
+                    return null;
+                }
+                final long pairLength = readProtoVarint(data, cursor);
+                position = cursor[0];
+                if (pairLength < 0 || pairLength > data.length - position) {
+                    return null;
+                }
+                final int pairEnd = position + (int) pairLength;
+                String key = null;
+                String value = null;
+                while (position < pairEnd) {
+                    cursor[0] = position;
+                    final long pairTag = readProtoVarint(data, cursor);
+                    position = cursor[0];
+                    if ((pairTag & 7) != 2) {
+                        return null;
+                    }
+                    final long length = readProtoVarint(data, cursor);
+                    position = cursor[0];
+                    if (length < 0 || length > pairEnd - position) {
+                        return null;
+                    }
+                    final String text = new String(data, position, (int) length,
+                            StandardCharsets.UTF_8);
+                    position += (int) length;
+                    final int field = (int) (pairTag >>> 3);
+                    if (field == 1) {
+                        key = text;
+                    } else if (field == 2) {
+                        value = text;
+                    }
+                }
+                if (wantedKey.equals(key)) {
+                    return value;
+                }
+                position = pairEnd;
+            }
+        } catch (final IllegalArgumentException ignored) {
+        }
+        return null;
+    }
+
+    private static long readProtoVarint(@Nonnull final byte[] data, @Nonnull final int[] cursor) {
+        long value = 0L;
+        int shift = 0;
+        while (cursor[0] < data.length && shift < 64) {
+            final int current = data[cursor[0]++] & 0xff;
+            value |= (long) (current & 0x7f) << shift;
+            if ((current & 0x80) == 0) {
+                return value;
+            }
+            shift += 7;
+        }
+        throw new IllegalArgumentException("Malformed protobuf varint");
+    }
