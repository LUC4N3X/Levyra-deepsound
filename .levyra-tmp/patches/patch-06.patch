+    @Nullable
+    public static AudioTrackType extractAudioTrackType(@Nullable final String xtags) {
+        final String acont = extractXtagsValue(xtags, "acont");
+        if (isNullOrEmpty(acont)) {
+            return null;
+        }
+        switch (acont.toLowerCase(Locale.ROOT)) {
