+    private static final Pattern SONG_METADATA_DATE_PATTERN =
+            Pattern.compile("\\b(\\d{4}-\\d{2}-\\d{2})\\b");
+    private static final String SONG_METADATA_SEPARATOR = " · ";
+    private static final List<String> SONG_METADATA_PROVIDER_PREFIXES = Arrays.asList(
+            "Provided to YouTube by ",
+            "Fornito a YouTube da ",
+            "Proporcionado a YouTube por ",
+            "Fourni à YouTube par ",
+            "Bereitgestellt für YouTube von ",
+            "Fornecido ao YouTube por "
+    );
+    private static final List<String> SONG_METADATA_COMPOSER_ROLES = Arrays.asList(
+            "composer", "lyricist", "songwriter", "writer",
+            "compositore", "paroliere", "compositor", "letrista",
+            "compositeur", "auteur", "komponist", "texter"
+    );
+    private static final List<String> SONG_METADATA_PERFORMER_ROLES = Arrays.asList(
+            "performer", "vocal", "singer", "musician",
+            "esecutore", "interprete", "cantante", "musicista",
+            "interpreter", "chanteur", "musicien", "musiker"
+    );
