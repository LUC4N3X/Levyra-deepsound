+package org.schabi.newpipe.extractor.services.youtube.extractors;
+
+import com.grack.nanojson.JsonObject;
+import com.grack.nanojson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class YoutubeLocalizedMixTopicTest {
+    @Test
+    void topicChannelNameIsNormalizedFromZuluRendererText() throws Exception {
+        final JsonObject item = JsonParser.object().from("{"
+                + "\"title\":{\"simpleText\":\"Artist - Isihloko\"},"
+                + "\"channelId\":\"UC123\"}"
+        );
+
+        assertEquals("Artist - Topic", new YoutubeChannelInfoItemExtractor(item).getName());
+    }
+
+    @Test
+    void autoGeneratedMixKeepsCanonicalTitleAndUploader() throws Exception {
+        final JsonObject item = JsonParser.object().from("{"
+                + "\"title\":{\"simpleText\":\"Imiksi - Artist\"},"
+                + "\"shareUrl\":\"https://www.youtube.com/playlist?list=RDM7lc1UVf-VE\"}"
+        );
+        final YoutubeMixOrPlaylistInfoItemExtractor extractor =
+                new YoutubeMixOrPlaylistInfoItemExtractor(item);
+
+        assertEquals("Mix - Artist", extractor.getName());
+        assertEquals("YouTube", extractor.getUploaderName());
+    }
+}
