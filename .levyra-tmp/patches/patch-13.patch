+package org.schabi.newpipe.extractor.services.youtube;
+
+import org.junit.jupiter.api.Test;
+import org.schabi.newpipe.extractor.MediaFormat;
+import org.schabi.newpipe.extractor.stream.AudioTrackType;
+
+import java.lang.reflect.Modifier;
+import java.util.Arrays;
+import java.util.Locale;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class YoutubeModernAudioMetadataTest {
+    private static final String ORIGINAL_XTAGS =
+            "ChEKBWFjb250EghvcmlnaW5hbAoNCgRsYW5nEgVlbi1VUw";
+    private static final String DUBBED_XTAGS =
+            "ChQKBWFjb250EgtkdWJiZWQtYXV0bwoKCgRsYW5nEgJhcg";
+    private static final String DESCRIPTIVE_XTAGS =
+            "ChQKBWFjb250EgtkZXNjcmlwdGl2ZQ";
+
+    @Test
+    void parsesTrackTypeAndLocaleFromXtagsWithoutLocalizedLabels() {
+        assertEquals(AudioTrackType.ORIGINAL,
+                YoutubeParsingHelper.extractAudioTrackType(ORIGINAL_XTAGS));
+        assertEquals("en-US", YoutubeParsingHelper.extractXtagsValue(ORIGINAL_XTAGS, "lang"));
+        assertEquals(AudioTrackType.DUBBED,
+                YoutubeParsingHelper.extractAudioTrackType(DUBBED_XTAGS));
+        assertEquals("ar", YoutubeParsingHelper.extractXtagsValue(DUBBED_XTAGS, "lang"));
+        assertEquals(AudioTrackType.DESCRIPTIVE,
+                YoutubeParsingHelper.extractAudioTrackType(DESCRIPTIVE_XTAGS));
+        assertNull(YoutubeParsingHelper.extractXtagsValue(DESCRIPTIVE_XTAGS, "lang"));
+    }
+
+    @Test
+    void copyConstructorPreservesModernFormatMetadataAndIdentity() throws Exception {
+        final ItagItem original = ItagItem.getItag(251);
+        original.setAudioTrackId("en-US.1");
+        original.setAudioTrackName("English");
+        original.setAudioTrackType(AudioTrackType.ORIGINAL);
+        original.setAudioLocale(Locale.forLanguageTag("en-US"));
+        original.setIsDrc(true);
+        original.setLastModified(1_725_000_000L);
+        original.setXtags(ORIGINAL_XTAGS);
+        original.setAutoGenerated(false);
+        original.setCodec("opus");
+        original.setInitStart(0);
+        original.setInitEnd(265);
+
+        final ItagItem copy = new ItagItem(original);
+
+        assertEquals("en-US.1", copy.getAudioTrackId());
+        assertEquals("English", copy.getAudioTrackName());
+        assertEquals(AudioTrackType.ORIGINAL, copy.getAudioTrackType());
+        assertEquals(Locale.forLanguageTag("en-US"), copy.getAudioLocale());
+        assertTrue(copy.isDrc());
+        assertEquals(1_725_000_000L, copy.getLastModified());
+        assertEquals(ORIGINAL_XTAGS, copy.getXtags());
+        assertEquals(original.formatIdentity(), copy.formatIdentity());
+
+        copy.setAudioTrackId("ar.1");
+        copy.setAudioLocale(Locale.forLanguageTag("ar"));
+        copy.setAudioTrackType(AudioTrackType.DUBBED);
+        copy.setXtags(DUBBED_XTAGS);
+        copy.setAutoGenerated(true);
+        assertNotEquals(original.formatIdentity(), copy.formatIdentity());
+    }
+
+    @Test
+    void serviceWorkerDataParserExtractsWebClientVersion() throws Exception {
+        final String[] fields = new String[17];
+        Arrays.fill(fields, "null");
+        fields[16] = "\"2.20260805.01.00\"";
+        final String payload = ")]}'[[null,null,[[[" + String.join(",", fields) + "]]]]]";
+
+        assertEquals("2.20260805.01.00",
+                YoutubeParsingHelper.extractClientVersionFromSwJsDataResponse(payload));
+    }
+
+    @Test
+    void webClientVersionResolutionIsSingleFlightWithinTheProcess() throws Exception {
+        assertTrue(Modifier.isSynchronized(
+                YoutubeParsingHelper.class.getDeclaredMethod("getClientVersion").getModifiers()));
+    }
+}
