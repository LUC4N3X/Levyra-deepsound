+package org.schabi.newpipe.extractor.services.youtube;
+
+import org.junit.jupiter.api.Test;
+import org.schabi.newpipe.extractor.stream.Description;
+import org.schabi.newpipe.extractor.stream.SongMetadata;
+
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class YoutubeSongMetadataTest {
+    @Test
+    void parsesStructuredMusicDescriptionWithoutRestrictingUnicodeOrMultiWordArtists() {
+        final String description = String.join("\n",
+                "Provided to YouTube by Example Distribution",
+                "",
+                "Midnight · Version · The Artist Name",
+                "",
+                "Album Name",
+                "",
+                "℗ 2026 Example Label",
+                "",
+                "Released on: 2026-08-14",
+                "",
+                "Associated Performer, Vocals: The Artist Name",
+                "Composer Lyricist: Ana Writer",
+                "Composer: Ben Writer",
+                "Associated Performer, Guitar: Guitar Person",
+                "",
+                "Auto-generated by YouTube.");
+
+        final SongMetadata metadata = YoutubeParsingHelper.getSongMetadata(
+                new Description(description, Description.PLAIN_TEXT));
+
+        assertNotNull(metadata);
+        assertEquals("Midnight · Version", metadata.getTitle());
+        assertEquals("The Artist Name", metadata.getArtist());
+        assertEquals("Album Name", metadata.getAlbum());
+        assertEquals("Example Distribution", metadata.getLabel());
+        assertEquals("2026 Example Label", metadata.getCopyright());
+        assertEquals(LocalDate.of(2026, 8, 14),
+                metadata.getReleaseDate().offsetDateTime().toLocalDate());
+        assertEquals("Ana Writer, Ben Writer", metadata.getComposer());
+        assertEquals(List.of("The Artist Name", "Guitar Person"), metadata.getPerformers());
+    }
+
+    @Test
+    void parsesLocalizedProviderAndReleaseLabelsFromTheStableBlockStructure() {
+        final String description = String.join("\r\n",
+                "Fornito a YouTube da Etichetta Esempio",
+                "",
+                "Titolo Brano · Artista È",
+                "",
+                "Album Italiano",
+                "",
+                "℗ 2025 Etichetta Esempio",
+                "",
+                "Pubblicato il: 2025-01-02",
+                "",
+                "Associated Performer, Vocals: Artista È",
+                "",
+                "Generato automaticamente da YouTube.");
+
+        final SongMetadata metadata = YoutubeParsingHelper.parseSongMetadataText(description);
+
+        assertNotNull(metadata);
+        assertEquals("Etichetta Esempio", metadata.getLabel());
+        assertEquals("Titolo Brano", metadata.getTitle());
+        assertEquals("Artista È", metadata.getArtist());
+        assertEquals(LocalDate.of(2025, 1, 2),
+                metadata.getReleaseDate().offsetDateTime().toLocalDate());
+    }
+
+    @Test
+    void localizedContributorRolesRemainStructured() {
+        final String description = String.join("\n",
+                "Fornito a YouTube da Etichetta",
+                "",
+                "Canzone · Artista",
+                "",
+                "Album",
+                "",
+                "℗ 2026 Etichetta",
+                "",
+                "Pubblicato il: 2026-02-03",
+                "",
+                "Interprete, Voce: Artista",
+                "Compositore: Autore Uno",
+                "Paroliere: Autore Due",
+                "",
+                "Generato automaticamente da YouTube.");
+
+        final SongMetadata metadata = YoutubeParsingHelper.parseSongMetadataText(description);
+
+        assertNotNull(metadata);
+        assertEquals(List.of("Artista"), metadata.getPerformers());
+        assertEquals("Autore Uno, Autore Due", metadata.getComposer());
+    }
+
+    @Test
+    void htmlDescriptionsPreserveParagraphBoundaries() {
+        final String html = "<p>Provided to YouTube by Label</p>"
+                + "<p>Song · Artist</p>"
+                + "<p>Album</p>"
+                + "<p>℗ 2024 Label</p>"
+                + "<p>Released on: 2024-11-03</p>"
+                + "<p>Composer: Writer</p>"
+                + "<p>Auto-generated by YouTube.</p>";
+
+        final SongMetadata metadata = YoutubeParsingHelper.getSongMetadata(
+                new Description(html, Description.HTML));
+
+        assertNotNull(metadata);
+        assertEquals("Song", metadata.getTitle());
+        assertEquals("Artist", metadata.getArtist());
+        assertEquals("Writer", metadata.getComposer());
+    }
+
+    @Test
+    void ordinaryDescriptionsDoNotProduceFalseSongMetadata() {
+        assertNull(YoutubeParsingHelper.parseSongMetadataText(
+                "A normal video description with a date 2026-08-14 and YouTube in the text."));
+        assertNull(YoutubeParsingHelper.parseSongMetadataText(String.join("\n\n",
+                "YouTube music recommendations",
+                "Fake song · Fake artist",
+                "Fake album",
+                "Released on: 2026-08-14")));
+    }
+
+    @Test
+    void metadataModelDefensivelyCopiesPerformers() {
+        final ArrayList<String> performers = new ArrayList<>(List.of("One", "Two"));
+        final SongMetadata metadata = new SongMetadata.Builder("Song", "Artist")
+                .setPerformers(performers)
+                .addPerformer("Two")
+                .build();
+        performers.add("Three");
+
+        assertEquals(List.of("One", "Two"), metadata.getPerformers());
+        assertThrows(UnsupportedOperationException.class,
+                () -> metadata.getPerformers().add("Four"));
+    }
+}
