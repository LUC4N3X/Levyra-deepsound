+package org.schabi.newpipe.extractor.services.youtube.sabr;
+
+import com.grack.nanojson.JsonArray;
+import com.grack.nanojson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.schabi.newpipe.extractor.stream.AudioTrackType;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class YoutubeSabrFormatIdentityTest {
+    private static final String ORIGINAL_XTAGS =
+            "ChEKBWFjb250EghvcmlnaW5hbAoNCgRsYW5nEgVlbi1VUw";
+    private static final String DUBBED_XTAGS =
+            "ChQKBWFjb250EgtkdWJiZWQtYXV0bwoKCgRsYW5nEgJhcg";
+
+    @Test
+    void sameItagAudioVariantsKeepDistinctInitializationIdentity() throws Exception {
+        final JsonArray formats = JsonParser.array().from("["
+                + audioFormat("en-US.1", ORIGINAL_XTAGS, true) + ","
+                + audioFormat("ar.1", DUBBED_XTAGS, false) + ","
+                + videoFormat()
+                + "]");
+        final List<YoutubeSabrFormat> parsed = YoutubeSabrFormat.parseAdaptiveFormats(formats);
+        final YoutubeSabrFormat original = parsed.get(0);
+        final YoutubeSabrFormat dubbed = parsed.get(1);
+
+        assertEquals(AudioTrackType.ORIGINAL, original.getAudioTrackType());
+        assertEquals("en-US", original.getAudioLocale());
+        assertTrue(original.isOriginalAudio());
+        assertEquals(AudioTrackType.DUBBED, dubbed.getAudioTrackType());
+        assertEquals("ar", dubbed.getAudioLocale());
+        assertTrue(dubbed.isAutoGeneratedAudio());
+        assertNotEquals(original.formatIdentity(), dubbed.formatIdentity());
+    }
+
+    @Test
+    void streamStateRejectsStateReuseAcrossSameItagLanguageVariants() throws Exception {
+        final JsonArray formats = JsonParser.array().from("["
+                + audioFormat("en-US.1", ORIGINAL_XTAGS, true) + ","
+                + audioFormat("ar.1", DUBBED_XTAGS, false) + ","
+                + videoFormat()
+                + "]");
+        final List<YoutubeSabrFormat> parsed = YoutubeSabrFormat.parseAdaptiveFormats(formats);
+        final YoutubeSabrStreamState state = new YoutubeSabrStreamState(parsed.get(0), parsed.get(2));
+
+        assertThrows(IllegalArgumentException.class, () -> state.getBufferedEndMs(parsed.get(1)));
+    }
+
+    private static String audioFormat(final String trackId, final String xtags,
+                                      final boolean isDefault) {
+        return "{"
+                + "\"itag\":251,"
+                + "\"lastModified\":\"1725000000\","
+                + "\"xtags\":\"" + xtags + "\","
+                + "\"mimeType\":\"audio/webm; codecs=\\\"opus\\\"\","
+                + "\"audioTrack\":{\"id\":\"" + trackId + "\","
+                + "\"displayName\":\"track\",\"audioIsDefault\":" + isDefault + "},"
+                + "\"bitrate\":128000,\"contentLength\":\"1000\","
+                + "\"approxDurationMs\":\"10000\","
+                + "\"initRange\":{\"start\":\"0\",\"end\":\"265\"},"
+                + "\"url\":\"https://r1---sn-example.googlevideo.com/videoplayback?itag=251\""
+                + "}";
+    }
+
+    private static String videoFormat() {
+        return "{"
+                + "\"itag\":137,\"lastModified\":\"1725000000\","
+                + "\"mimeType\":\"video/mp4; codecs=\\\"avc1.640028\\\"\","
+                + "\"qualityLabel\":\"1080p\",\"width\":1920,\"height\":1080,"
+                + "\"bitrate\":3000000,\"contentLength\":\"2000\","
+                + "\"approxDurationMs\":\"10000\","
+                + "\"initRange\":{\"start\":\"0\",\"end\":\"739\"},"
+                + "\"url\":\"https://r1---sn-example.googlevideo.com/videoplayback?itag=137\""
+                + "}";
+    }
+}
