{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.02,
  "extraKnownMarketplaces": {
    "chrisbanes-skills": {
      "source": {
        "source": "github",
        "repo": "chrisbanes/skills"
      }
    },
    "Kotlin": {
      "source": {
        "source": "github",
        "repo": "Kotlin/kotlin-agent-skills"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "multica-ai/andrej-karpathy-skills"
      }
    }
  },
  "enabledPlugins": {
    "chrisbanes-skills@chrisbanes-skills": true,
    "kotlin-agent-skills@Kotlin": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew --no-daemon :app:testDebugUnitTest*)",
      "Bash(./gradlew --no-daemon :app:lintRelease*)",
      "Bash(./gradlew --no-daemon --version)",
      "Bash(./gradlew --no-daemon tasks*)",
      "Bash(./gradlew --no-daemon projects)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(python3 scripts/check_android_regex_compatibility.py)",
      "mcp__jcodemunch"
    ],
    "deny": [
      "Read(./local.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Write(./local.properties)",
      "Write(./**/*.jks)",
      "Write(./**/*.keystore)",
      "Write(./**/.env)",
      "Write(./**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 600,
            "statusMessage": "Preparing Levyra tooling"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/jcodemunch-start.sh\"",
            "timeout": 600,
            "statusMessage": "Preparing Levyra jCodeMunch"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/user-prompt-submit.sh\""
          }
        ]
      }
    ]
  }
}
