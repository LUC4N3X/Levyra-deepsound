prefix_rule(
    pattern=["git", ["status", "rev-parse", "ls-files"]],
    decision="allow",
    match=["git status --short", "git ls-files", "git rev-parse HEAD"],
    not_match=["git push", "git reset --hard", "git commit -m x", "git checkout main", "git log --output=file", "git show --output=file"],
)

prefix_rule(
    pattern=["gh", "pr", ["view", "list", "checks", "diff", "status"]],
    decision="allow",
    match=["gh pr view 1018", "gh pr checks 1018", "gh pr diff 1018"],
    not_match=["gh pr create", "gh pr merge 1018", "gh pr edit 1018", "gh pr ready 1018"],
)

prefix_rule(
    pattern=["gh", "run", ["view", "list"]],
    decision="allow",
    match=["gh run list", "gh run view 123 --log-failed"],
    not_match=["gh run rerun 123", "gh run cancel 123", "gh run delete 123"],
)

prefix_rule(
    pattern=["gh", "issue", ["view", "list"]],
    decision="allow",
    match=["gh issue view 1", "gh issue list"],
    not_match=["gh issue create", "gh issue close 1", "gh issue comment 1"],
)

prefix_rule(
    pattern=["rtk", ["gain", "verify"]],
    decision="allow",
    match=["rtk gain", "rtk gain --history", "rtk verify"],
    not_match=["rtk trust", "rtk init", "rtk run ls"],
)
